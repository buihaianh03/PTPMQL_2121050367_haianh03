@model IEnumerable<DemoMVC.Models.TrainingSystem>

@{
    ViewData["Title"] = "Danh mục hệ đào tạo";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Danh mục hệ đào tạo</h1>
    <a asp-action="Create" class="btn btn-primary">Thêm hệ</a>
</div>
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-8">
        <input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Tìm tên hoặc mã hệ" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
    </div>
</form>
<div class="alert alert-info">Mã hệ có thể để trống trong danh mục; sinh viên chỉ tạo được khi mã 2 chữ số đã được cấu hình.</div>
<table class="table table-striped">
    <thead><tr><th>Tên hệ</th><th>Mã sinh viên</th><th></th></tr></thead>
    <tbody>
    @foreach (var system in Model)
    {
        <tr>
            <td>@system.Name</td>
            <td>@(system.StudentCode ?? "Chưa cấu hình")</td>
            <td><a asp-action="Edit" asp-route-id="@system.Id">Sửa</a> | <a asp-action="Delete" asp-route-id="@system.Id">Xóa</a></td>
        </tr>
    }
    </tbody>
</table>
