@model DemoMVC.ViewModels.PaginatedListViewModel<DemoMVC.Models.TrainingSystem>

@{
    ViewData["Title"] = "Danh mục hệ đào tạo";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Danh mục hệ đào tạo</h1>
    <a asp-action="Create" class="btn btn-primary" data-ajax-modal data-modal-title="Thêm hệ đào tạo">Thêm hệ</a>
</div>
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-6">
        <input name="search" value="@Model.Pagination.SearchTerm" class="form-control" placeholder="Tìm theo mã, tên hoặc mã hệ" />
    </div>
    <div class="col-sm-2">
        <select name="pageSize" class="form-select" aria-label="Số bản ghi mỗi trang">
            @foreach (var size in DemoMVC.ViewModels.PaginationViewModel.PageSizeOptions)
            {
                <option value="@size" selected="@(size == Model.Pagination.PageSize ? "selected" : null)">@size bản ghi/trang</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Làm mới</a>
    </div>
</form>
<div class="alert alert-info">Mã hệ có thể để trống trong danh mục; sinh viên chỉ tạo được khi mã 2 chữ số đã được cấu hình.</div>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>Tên hệ</th><th>Mã sinh viên</th><th></th></tr></thead>
        <partial name="_Rows" model="Model.Items" />
    </table>
</div>
<div id="pagination-container" data-ajax-pagination data-page="@Model.Pagination.Page" data-page-size="@Model.Pagination.PageSize">
    <partial name="_Pagination" model="Model.Pagination" />
</div>
