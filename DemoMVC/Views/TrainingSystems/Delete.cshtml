@model DemoMVC.Models.TrainingSystem

@{
    ViewData["Title"] = "Xóa hệ đào tạo";
}

<h1>Xóa hệ đào tạo</h1>
<p>Bạn có chắc muốn xóa hệ <strong>@Model.Name</strong> không?</p>
<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
    <a asp-action="Index" class="btn btn-outline-secondary" data-modal-cancel>Hủy</a>
</form>
