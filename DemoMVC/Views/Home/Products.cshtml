@{
    ViewData["Title"] = "Sản phẩm";
}

<div class="text-center mb-4">
    <h1 class="fw-bold text-primary">
        <i class="bi bi-box-seam me-2"></i>
        Sản phẩm
    </h1>

    <p class="text-muted">
        Danh sách sản phẩm của hệ thống
    </p>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card feature-card h-100 shadow-sm">
            <div class="card-body text-center p-4">
                <i class="bi bi-laptop display-4 text-primary"></i>
                <h4 class="mt-3">Sản phẩm 1</h4>
                <p class="text-muted">
                    Nội dung giới thiệu sản phẩm thứ nhất.
                </p>
                <button class="btn btn-primary">
                    Xem chi tiết
                </button>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card feature-card h-100 shadow-sm">
            <div class="card-body text-center p-4">
                <i class="bi bi-phone display-4 text-success"></i>
                <h4 class="mt-3">Sản phẩm 2</h4>
                <p class="text-muted">
                    Nội dung giới thiệu sản phẩm thứ hai.
                </p>
                <button class="btn btn-success">
                    Xem chi tiết
                </button>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card feature-card h-100 shadow-sm">
            <div class="card-body text-center p-4">
                <i class="bi bi-headphones display-4 text-danger"></i>
                <h4 class="mt-3">Sản phẩm 3</h4>
                <p class="text-muted">
                    Nội dung giới thiệu sản phẩm thứ ba.
                </p>
                <button class="btn btn-danger">
                    Xem chi tiết
                </button>
            </div>
        </div>
    </div>
</div>