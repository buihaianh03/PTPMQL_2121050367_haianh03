@model IEnumerable<DemoMVC.Models.Major>

@{
    ViewData["Title"] = "Danh mục ngành học";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Danh mục ngành học</h1>
    <a asp-action="Create" class="btn btn-primary" data-ajax-modal data-modal-title="Thêm ngành học">Thêm ngành</a>
</div>
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-8">
        <input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Tìm tên hoặc mã ngành" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
    </div>
</form>
<div class="alert alert-info">Mã tuyển sinh chính thức (nếu có) được lưu riêng; mã dùng trong MaSV phải là 2 chữ số do bạn cấu hình.</div>
<table class="table table-striped">
    <thead><tr><th>Tên ngành</th><th>Mã tuyển sinh</th><th>Mã trong MaSV</th><th></th></tr></thead>
    <partial name="_Rows" model="Model" />
</table>
