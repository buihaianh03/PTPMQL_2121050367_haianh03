@model IEnumerable<DemoMVC.ViewModels.FacultyDetailsViewModel>

@{
    ViewData["Title"] = "Quản lý khoa";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Quản lý khoa</h1>
    <a asp-action="Create" class="btn btn-primary" data-ajax-modal data-modal-title="Thêm khoa">Thêm khoa</a>
</div>
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-8">
        <input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Tìm tên khoa" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
    </div>
</form>

<table class="table table-striped">
    <thead><tr><th>Mã khoa</th><th>Tên khoa</th><th></th></tr></thead>
    <partial name="_Rows" model="Model" />
</table>
