@model DemoMVC.ViewModels.PaginatedListViewModel<DemoMVC.Models.Person>

<div data-list-fragment>
    <table>
        <partial name="_Rows" model="Model.Items" />
    </table>
    <div data-ajax-pagination data-page="@Model.Pagination.Page" data-page-size="@Model.Pagination.PageSize">
        <partial name="_Pagination" model="Model.Pagination" />
    </div>
</div>
