@model IEnumerable<DemoMVC.Models.Person>

<h1>Person List</h1>

<a asp-action="Create" class="btn btn-primary">
    Create New
</a>

<table class="table">

<tr>
    <th>Id</th>
    <th>Full Name</th>
    <th>Address</th>
    <th></th>
</tr>


@foreach(var item in Model)
{
    <tr>
        <td>@item.Id</td>
        <td>@item.FullName</td>
        <td>@item.Address</td>

        <td>
            <a asp-action="Edit" asp-route-id="@item.Id">
                Edit
            </a>

            <a asp-action="Delete" asp-route-id="@item.Id">
                Delete
            </a>
        </td>
    </tr>
}

</table>