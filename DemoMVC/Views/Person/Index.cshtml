@model IEnumerable<DemoMVC.Models.Person>

@{
    ViewData["Title"] = "Quản lý người";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Quản lý người</h1>
    <a asp-action="Create" class="btn btn-primary" data-ajax-modal data-modal-title="Thêm người">Thêm người</a>
</div>

<table class="table table-striped align-middle">
    <thead><tr><th>Mã</th><th>Họ tên</th><th>Địa chỉ</th><th></th></tr></thead>
    <partial name="_Rows" model="Model" />
</table>