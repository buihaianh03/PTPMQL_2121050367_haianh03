@model DemoMVC.Models.Person


<h1>Xóa người</h1>


<h3>Bạn có chắc chắn muốn xóa người này?</h3>


<div>

<h4>
@Model.FullName
</h4>


<p>
@Model.Address
</p>


</div>


<form asp-action="Delete" method="post">

<input type="hidden"
       asp-for="Id"/>


<input type="submit"
       value="Xác nhận xóa"
       class="btn btn-danger"/>


</form>

<button type="button" class="btn btn-outline-secondary" data-modal-cancel>Hủy</button>