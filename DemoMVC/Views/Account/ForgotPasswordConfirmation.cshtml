@{
    ViewData["Title"] = "Kiểm tra email";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="alert alert-info shadow-sm">
            <h1 class="h4">Kiểm tra hộp thư</h1>
            <p class="mb-0">Nếu email thuộc tài khoản đã xác thực và dịch vụ email hoạt động, hệ thống sẽ gửi hướng dẫn đặt lại mật khẩu. Nếu không nhận được thư, hãy kiểm tra thư rác hoặc liên hệ quản trị viên. Vì lý do bảo mật, trang này không xác nhận email có tồn tại hay trạng thái gửi thư.</p>
        </div>
    </div>
</div>
