@model DemoMVC.ViewModels.StudentFormViewModel

@{
    ViewData["Title"] = "Thêm sinh viên";
}

<h1>Thêm sinh viên</h1>

<form asp-action="Create" method="post" id="student-form" data-is-edit="false"
      data-preview-url="@Url.Action("PreviewCode", "StudentRecords")">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_StudentFormFields" model="Model" />
    <button type="submit" class="btn btn-primary">Lưu sinh viên</button>
    <a asp-action="Index" class="btn btn-outline-secondary" data-modal-cancel>Quay lại</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
