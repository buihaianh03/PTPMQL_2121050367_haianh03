@model DemoMVC.ViewModels.StudentFormViewModel

@{
    ViewData["Title"] = "Sửa sinh viên";
}

<h1>Sửa sinh viên</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="student-form" data-is-edit="true"
      data-preview-url="@Url.Action("PreviewCode", "StudentRecords")">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_StudentFormFields" model="Model" />
    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/student-form.js" asp-append-version="true"></script>
}
